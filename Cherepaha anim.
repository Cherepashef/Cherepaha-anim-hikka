    # ==================== СТИЛИ АНИМАЦИЙ ====================
    
    def _get_frames_typewriter(self, content: str, is_emoji: bool) -> list:
        """Эффект печатной машинки"""
        frames = []
        if is_emoji:
            chars = list(content)
        else:
            chars = list(content)
        
        current = ""
        for char in chars:
            current += char
            frames.append(current + "▌")
        frames.append(content)
        return frames

    def _get_frames_wave(self, content: str, is_emoji: bool) -> list:
        """Волновой эффект"""
        frames = []
        chars = list(content)
        length = len(chars)
        
        for i in range(length + 5):
            frame = ""
            for j, char in enumerate(chars):
                if j <= i:
                    if j == i or j == i - 1:
                        frame += f"**{char}**"
                    else:
                        frame += char
                else:
                    frame += "·"
            frames.append(frame)
        frames.append(content)
        return frames

    def _get_frames_bounce(self, content: str, is_emoji: bool) -> list:
        """Эффект отскока"""
        frames = []
        prefixes = ["", " ", "  ", "   ", "  ", " ", ""]
        
        for prefix in prefixes * 2:
            frames.append(f"{prefix}{content}")
        frames.append(content)
        return frames

    def _get_frames_fade(self, content: str, is_emoji: bool) -> list:
        """Эффект появления"""
        frames = []
        fade_chars = ["░", "▒", "▓", "█"]
        
        for fade in fade_chars:
            frames.append(fade * len(content))
        
        chars = list(content)
        revealed = ""
        for char in chars:
            revealed += char
            remaining = len(content) - len(revealed)
            frames.append(revealed + "▓" * remaining)
        
        frames.append(content)
        return frames

    def _get_frames_glitch(self, content: str, is_emoji: bool) -> list:
        """Глитч эффект"""
        import random
        frames = []
        glitch_chars = ["#", "@", "!", "%", "&", "?", "*", "~"]
        
        for intensity in range(5, 0, -1):
            frame = ""
            for char in content:
                if random.random() < intensity * 0.15:
                    frame += random.choice(glitch_chars)
                else:
                    frame += char
            frames.append(frame)
        
        frames.append(content)
        return frames

    def _get_frames_matrix(self, content: str, is_emoji: bool) -> list:
        """Матрица эффект"""
        import random
        frames = []
        matrix_chars = "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン"
        
        for i in range(8):
            frame = ""
            for j, char in enumerate(content):
                if j < len(content) - i * (len(content) // 8):
                    frame += random.choice(matrix_chars)
                else:
                    frame += char
            frames.append(frame)
        
        frames.append(content)
        return frames

    def _get_frames_rainbow(self, content: str, is_emoji: bool) -> list:
        """Радужный эффект с эмодзи"""
        frames = []
        rainbow = ["🔴", "🟠", "🟡", "🟢", "🔵", "🟣"]
        
        for i in range(len(rainbow) + len(content)):
            frame = ""
            for j, char in enumerate(content):
                if j <= i:
                    frame += char
                else:
                    idx = (i - j) % len(rainbow)
                    frame += rainbow[idx]
            frames.append(frame)
        
        frames.append(content)
        return frames

    def _get_frames(self, content: str, is_emoji: bool, style: str) -> list:
        """Получить кадры анимации по стилю"""
        style_methods = {
            "typewriter": self._get_frames_typewriter,
            "wave": self._get_frames_wave,
            "bounce": self._get_frames_bounce,
            "fade": self._get_frames_fade,
            "glitch": self._get_frames_glitch,
            "matrix": self._get_frames_matrix,
            "rainbow": self._get_frames_rainbow,
        }
        
        method = style_methods.get(style, self._get_frames_typewriter)
        return method(content, is_emoji)

    # ==================== КОМАНДЫ ====================

    @loader.command(ru_doc="[emoji/text] [контент] [время] - Запустить анимацию")
    async def animcmd(self, message: Message):
        """[emoji/text] [content] [time] - Run animation"""
        args = utils.get_args_raw(message)
        
        if not args:
            await utils.answer(message, self.strings["no_args"])
            return

        parts = args.split(maxsplit=2)
        
        if len(parts) < 3:
            await utils.answer(message, self.strings["no_args"])
            return

        anim_type, content, duration = parts[0].lower(), parts[1], parts[2]

        if anim_type not in ["emoji", "text"]:
            await utils.answer(message, self.strings["invalid_type"])
            return

        try:
            duration = float(duration)
            if not 1 <= duration <= 30:
                raise ValueError
        except ValueError:
            await utils.answer(message, self.strings["invalid_time"])
            return

        is_emoji = anim_type == "emoji"
        style = self.config["animation_style"]
        frames = self._get_frames(content, is_emoji, style)
        
        if not frames:
            await utils.answer(message, "❌ Ошибка генерации кадров")
            return

        frame_delay = duration / len(frames) * self.config["speed_multiplier"]
        frame_delay = max(0.1, min(frame_delay, self.config["frame_delay"]))

        loop_count = 3 if self.config["loop_animation"] else 1
        
        for _ in range(loop_count):
            for frame in frames:
                try:
                    await message.edit(frame)
                    await asyncio.sleep(frame_delay)
                except Exception as e:
                    logger.error(f"Animation error: {e}")
                    return

        # Финальное сообщение
        if self.config["end_message"]:
            await message.edit(self.config["end_message"])
        else:
            await message.edit(content)

