            f"📝 <b>Финальное сообщение:</b> <code>{self.config['end_message'] or 'Последний кадр'}</code>"
        )

    def _get_settings_markup(self) -> list:
        """Получить клавиатуру настроек"""
        return [
            [
                {"text": "🎨 Стиль", "callback": self._style_menu},
                {"text": "⚡ Скорость", "callback": self._speed_menu},
            ],
            [
                {"text": f"🔄 Цикл: {'✅' if self.config['loop_animation'] else '❌'}", 
                 "callback": self._toggle_loop},
                {"text": "⏱ Задержка", "callback": self._delay_menu},
            ],
            [
                {"text": "🎬 Превью", "callback": self._preview_callback},
            ],
            [
                {"text": "🔙 Закрыть", "callback": self._close_settings},
            ],
        ]

    async def _style_menu(self, call: InlineCall):
        """Меню выбора стиля"""
        styles = [
            ("✍️ Typewriter", "typewriter"),
            ("🌊 Wave", "wave"),
            ("🏀 Bounce", "bounce"),
            ("🌫 Fade", "fade"),
            ("⚡ Glitch", "glitch"),
            ("💚 Matrix", "matrix"),
            ("🌈 Rainbow", "rainbow"),
        ]
        
        buttons = []
        row = []
        for name, style in styles:
            current = "✓ " if self.config["animation_style"] == style else ""
            row.append({
                "text": f"{current}{name}",
                "callback": self._set_style,
                "args": (style,),
            })
            if len(row) == 2:
                buttons.append(row)
                row = []
        if row:
            buttons.append(row)
        
        buttons.append([{"text": "🔙 Назад", "callback": self._back_to_main}])
        
        await call.edit(
            "🎨 <b>Выберите стиль анимации:</b>",
            reply_markup=buttons,
        )

    async def _set_style(self, call: InlineCall, style: str):
        """Установить стиль"""
        self.config["animation_style"] = style
        await self._back_to_main(call)

    async def _speed_menu(self, call: InlineCall):
        """Меню настройки скорости"""
        speeds = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0]
        
        buttons = []
        row = []
        for speed in speeds:
            current = "✓ " if self.config["speed_multiplier"] == speed else ""
            row.append({
                "text": f"{current}{speed}x",
                "callback": self._set_speed,
                "args": (speed,),
            })
            if len(row) == 3:
                buttons.append(row)
                row = []
        if row:
            buttons.append(row)
        
        buttons.append([{"text": "🔙 Назад", "callback": self._back_to_main}])
        
        await call.edit(
            "⚡ <b>Выберите множитель скорости:</b>",
            reply_markup=buttons,
        )

    async def _set_speed(self, call: InlineCall, speed: float):
        """Установить скорость"""
        self.config["speed_multiplier"] = speed
        await self._back_to_main(call)

    async def _delay_menu(self, call: InlineCall):
        """Меню настройки задержки"""
        delays = [0.1, 0.2, 0.3, 0.5, 0.7, 1.0]
        
        buttons = []
        row = []
        for delay in delays:
            current = "✓ " if self.config["frame_delay"] == delay else ""
            row.append({
                "text": f"{current}{delay}с",
                "callback": self._set_delay,
                "args": (delay,),
            })
            if len(row) == 3:
                buttons.append(row)
                row = []
        if row:
            buttons.append(row)
        
        buttons.append([{"text": "🔙 Назад", "callback": self._back_to_main}])
        
        await call.edit(
            "⏱ <b>Выберите задержку между кадрами:</b>",
            reply_markup=buttons,
        )

    async def _set_delay(self, call: InlineCall, delay: float):
        """Установить задержку"""
        self.config["frame_delay"] = delay
        await self._back_to_main(call)

    async def _toggle_loop(self, call: InlineCall):
        """Переключить зацикливание"""
        self.config["loop_animation"] = not self.config["loop_animation"]
        await self._back_to_main(call)

    async def _preview_callback(self, call: InlineCall):
        """Превью текущего стиля"""
        style = self.config["animation_style"]
        frames = self._get_frames("Demo!", False, style)
        
        for frame in frames[:8]:
            try:
                await call.edit(
                    f"🎬 <b>Превью стиля</b> <code>{style}</code>\n\n{frame}",
                    reply_markup=[[{"text": "⏹ Стоп", "callback": self._back_to_main}]],
                )
                await asyncio.sleep(0.3)
            except:
                pass
        
        await asyncio.sleep(0.5)
        await self._back_to_main(call)

    async def _back_to_main(self, call: InlineCall):
        """Вернуться в главное меню"""
        await call.edit(
            self._get_settings_text(),
            reply_markup=self._get_settings_markup(),
        )

    async def _close_settings(self, call: InlineCall):
        """Закрыть настройки"""
        await call.delete()
